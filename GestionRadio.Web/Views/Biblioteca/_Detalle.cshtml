@model GestionRadio.Web.Models.ViewModels.Dinesat.DinesatExplorerViewModel

@if (Model.MaterialSeleccionado is null)
{
    <div class="text-center p-4">

        <i class="bi bi-music-note-beamed fs-1 text-secondary"></i>

        <h5 class="mt-3">
            Ningún material seleccionado
        </h5>

        <p class="text-muted">
            Seleccione un material del panel central para visualizar su información.
        </p>

    </div>
}
else
{
    <div class="p-3">

        <dl class="row">

            <dt class="col-sm-4">Código</dt>
            <dd class="col-sm-8">@Model.MaterialSeleccionado.Codigo</dd>

            <dt class="col-sm-4">Título</dt>
            <dd class="col-sm-8">@Model.MaterialSeleccionado.Titulo</dd>

            <dt class="col-sm-4">Duración</dt>
            <dd class="col-sm-8">@Model.MaterialSeleccionado.Duracion ms</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @(Model.MaterialSeleccionado.Activo ? "Activo" : "Inactivo")
            </dd>

        </dl>

    </div>
}