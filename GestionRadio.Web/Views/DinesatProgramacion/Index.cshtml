@model GestionRadio.Web.Models.ViewModels.Dinesat.DinesatProgramacionViewModel

@{
    ViewData["Title"] = "Continuidad Dinesat";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Continuidad Dinesat</h2>

        <span class="badge bg-primary fs-6">
            Programming ID: @Model.ProgrammingId
        </span>
    </div>

    @if (Model.Bloques.Count == 0)
    {
        <div class="alert alert-warning">
            No se encontraron bloques para esta programación.
        </div>
    }
    else
    {
        foreach (var bloque in Model.Bloques)
        {
            <div class="card shadow-sm mb-3">

                <div class="card-header bg-dark text-white">
                    <strong>@bloque.HoraInicio</strong>
                    &nbsp;
                    @bloque.Nombre
                </div>

                <div class="card-body p-0">

                    @if (bloque.Eventos.Count == 0)
                    {
                        <div class="p-3 text-muted">
                            Sin eventos.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm table-striped table-hover mb-0">

                            <thead class="table-dark">
                                <tr>
                                    <th style="width:70px;">Orden</th>
                                    <th style="width:120px;">Código</th>
                                    <th>Material</th>
                                    <th style="width:120px;">Traffic</th>
                                    <th style="width:110px;">Frames</th>
                                    <th style="width:90px;">Live</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var evento in bloque.Eventos)
                                {
                                    <tr>

                                        <td class="text-center">
                                            @evento.ItemOrder
                                        </td>

                                        <td>
                                            @evento.MaterialCode
                                        </td>

                                        <td>
                                            @evento.MaterialTitle
                                        </td>

                                        <td>
                                            @evento.TrafficCode
                                        </td>

                                        <td class="text-end">
                                            @evento.LengthFrames
                                        </td>

                                        <td class="text-end">
                                            @evento.LiveLength
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }

                </div>

            </div>
        }
    }

</div>