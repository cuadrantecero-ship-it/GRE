@model IEnumerable<GestionRadio.Application.DTOs.ClienteDto>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Clientes</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nuevo Cliente
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <table class="table table-bordered table-hover table-striped align-middle">

        <thead class="table-dark">

            <tr>
                <th>Folio</th>
                <th>Razón Social</th>
                <th>Contacto</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th class="text-center">Estado</th>
                <th width="250" class="text-center">Acciones</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Folio</td>
                    <td>@item.RazonSocial</td>
                    <td>@item.Contacto</td>
                    <td>@item.Telefono</td>
                    <td>@item.Email</td>

                    <td class="text-center">

                        @if (item.Activo)
                        {
                            <span class="badge bg-success">
                                ACTIVO
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                INACTIVO
                            </span>
                        }

                    </td>

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.IdCliente"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        @if (item.Activo)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@item.IdCliente"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Desea desactivar este cliente?');">

                                    Desactivar

                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-action="Reactivar"
                                  asp-route-id="@item.IdCliente"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-success btn-sm"
                                        onclick="return confirm('¿Desea reactivar este cliente?');">

                                    Reactivar

                                </button>

                            </form>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>