@model GestionRadio.Web.Models.ViewModels.Parrillas.ParrillaEventoEditViewModel

@{
    ViewData["Title"] = "Nuevo Evento de Parrilla";
}


<div class="container-fluid">

    <div class="row">

        <div class="col-lg-8 mx-auto">

            <div class="card shadow">


                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">

                        <i class="bi bi-plus-circle"></i>

                        Nuevo Evento de Parrilla

                    </h4>

                </div>



                <div class="card-body">


                    <form asp-controller="Parrillas"
                          asp-action="CrearEvento"
                          asp-route-id="@Model.ParrillaId"
                          method="post">


                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="id"
                               value="@Model.ParrillaId" />



                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>





                        <!-- HORA -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Hora
                            </label>


                            <input name="Hora"
                                   type="time"
                                   class="form-control"
                                   value="00:00" />

                        </div>





                        <!-- TIPO EVENTO -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Tipo Evento
                            </label>


                            <select name="TipoEventoId"
                                    class="form-select"
                                    required>


                                <option value="">
                                    -- Seleccione tipo --
                                </option>


                                @foreach (var tipo in Model.TiposEvento)
                                {

                                    <option value="@tipo.TipoEventoId">

                                        @tipo.TipoEventoId - @tipo.Nombre

                                    </option>

                                }


                            </select>


                        </div>






                        <!-- DESCRIPCION -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Descripción
                            </label>


                            <input name="Descripcion"
                                   class="form-control" />


                        </div>







                        <!-- PUBLICIDAD -->

                        <div class="form-check mb-3">


                            <input name="PermitePublicidad"
                                   type="checkbox"
                                   value="true"
                                   class="form-check-input" />


                            <label class="form-check-label">

                                Permite Publicidad

                            </label>


                        </div>







                        <!-- DURACION -->

                        <div class="mb-3">


                            <label class="form-label fw-bold">

                                Duración máxima segundos

                            </label>


                            <input name="DuracionMaximaSegundos"
                                   type="number"
                                   class="form-control"
                                   value="0" />


                        </div>








                        <!-- ORDEN -->

                        <div class="mb-3">


                            <label class="form-label fw-bold">

                                Orden

                            </label>


                            <input name="Orden"
                                   type="number"
                                   class="form-control"
                                   value="1" />


                        </div>







                        <div class="d-flex justify-content-end gap-2">


                            <a asp-action="Eventos"
                               asp-route-id="@Model.ParrillaId"
                               class="btn btn-secondary">


                                <i class="bi bi-arrow-left"></i>

                                Regresar


                            </a>




                            <button type="submit"
                                    class="btn btn-success">


                                <i class="bi bi-check-circle"></i>

                                Guardar


                            </button>



                        </div>


                    </form>


                </div>


            </div>


        </div>


    </div>


</div>



@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}