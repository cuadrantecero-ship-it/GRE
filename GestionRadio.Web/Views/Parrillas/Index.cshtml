@model IEnumerable<GestionRadio.Application.DTOs.Parrilla.ParrillaDto>

@{
    ViewData["Title"] = "Parrillas";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-grid-3x3-gap"></i>
                Parrillas de Programación
            </h2>

            <small class="text-muted">
                Configuración base de la programación de cada emisora.
            </small>

        </div>


        <a asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-circle"></i>

            Nueva Parrilla

        </a>

    </div>



    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    <div class="card shadow-sm">

        <div class="card-header">

            <strong>Listado de Parrillas</strong>

        </div>


        <div class="card-body">


            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Nombre</th>

                        <th>Emisora</th>

                        <th>Fecha Inicio</th>

                        <th>Fecha Fin</th>

                        <th>Estado</th>

                        <th width="330">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>


                    @if (Model.Any())
                    {

                        foreach (var item in Model)
                        {

                            <tr>


                                <td>
                                    @item.ParrillaId
                                </td>


                                <td>
                                    @item.Nombre
                                </td>


                                <td>
                                    @item.EmisoraId
                                </td>


                                <td>
                                    @item.FechaInicio
                                </td>


                                <td>
                                    @item.FechaFin
                                </td>


                                <td>

                                    @if (item.Activa)
                                    {
                                        <span class="badge bg-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactiva
                                        </span>
                                    }

                                </td>


                                <td>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.ParrillaId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil"></i>

                                        Editar

                                    </a>



                                    <a asp-action="Eventos"
                                       asp-route-id="@item.ParrillaId"
                                       class="btn btn-info btn-sm text-white">

                                        <i class="bi bi-clock-history"></i>

                                        Eventos

                                    </a>



                                    <form asp-action="Delete"
                                          asp-route-id="@item.ParrillaId"
                                          method="post"
                                          class="d-inline">


                                        @Html.AntiForgeryToken()


                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('¿Eliminar la parrilla?');">

                                            <i class="bi bi-trash"></i>

                                            Eliminar

                                        </button>


                                    </form>


                                </td>


                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="7"
                                class="text-center text-muted">

                                No existen parrillas registradas.

                            </td>

                        </tr>

                    }


                </tbody>


            </table>


        </div>

    </div>


</div>