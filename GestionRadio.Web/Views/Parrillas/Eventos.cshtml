@model IEnumerable<GestionRadio.Application.DTOs.Parrilla.ParrillaEventoDto>

@{
    ViewData["Title"] = "Eventos de Parrilla";

    var parrillaId = (long)ViewBag.ParrillaId;
}


<div class="container-fluid">


    <div class="d-flex justify-content-between align-items-center mb-4">


        <div>

            <h2 class="fw-bold">

                <i class="bi bi-clock-history"></i>

                Eventos de Parrilla

            </h2>


            <small class="text-muted">

                Línea de tiempo de programación

            </small>

        </div>



        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Regresar

        </a>


    </div>




    <div class="card shadow">


        <div class="card-header bg-primary text-white">

            Parrilla ID: @parrillaId

        </div>




        <div class="card-body">


            <table class="table table-bordered table-hover align-middle">


                <thead class="table-dark">


                    <tr>

                        <th>
                            Orden
                        </th>


                        <th>
                            Hora
                        </th>


                        <th>
                            Tipo Evento
                        </th>


                        <th>
                            Descripción
                        </th>


                        <th>
                            Publicidad
                        </th>


                    </tr>


                </thead>



                <tbody>


                    @foreach (var item in Model)
                    {

                        <tr>


                            <td>

                                @item.Orden

                            </td>



                            <td>

                                @item.Hora.ToString(@"hh\:mm")

                            </td>



                            <td>

                                @item.TipoEventoId

                            </td>



                            <td>

                                @item.Descripcion

                            </td>



                            <td>


                                @if (item.PermitePublicidad)
                                {

                                    <span class="badge bg-success">

                                        Sí

                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-secondary">

                                        No

                                    </span>

                                }


                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>


    </div>


</div>