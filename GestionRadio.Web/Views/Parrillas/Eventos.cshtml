@model IEnumerable<GestionRadio.Application.DTOs.Parrillas.ParrillaEventoDto>

@{
    ViewData["Title"] = "Programación Base";
    var parrillaId = (long)ViewBag.ParrillaId;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-0">PROGRAMACIÓN BASE</h2>
            <small class="text-muted">
                Configuración de la parrilla de la emisora
            </small>
        </div>

        <div>

            <a asp-action="NuevoEvento"
               asp-route-parrillaId="@parrillaId"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Nuevo Evento

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Regresar

            </a>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-hover table-striped align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th style="width:100px">
                            Hora
                        </th>

                        <th style="width:180px">
                            Tipo
                        </th>

                        <th>
                            Descripción
                        </th>

                        <th style="width:130px">
                            Publicidad
                        </th>

                        <th style="width:130px">
                            Duración
                        </th>

                        <th style="width:80px">
                            Orden
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center p-5">

                                No existen eventos configurados.

                            </td>

                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                @item.Hora

                            </td>

                            <td>

                                @item.TipoEventoId

                            </td>

                            <td>

                                @item.Descripcion

                            </td>

                            <td>

                                @if (item.PermitePublicidad)
                                {
                                    <span class="badge bg-success">
                                        SI
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        NO
                                    </span>
                                }

                            </td>

                            <td>

                                @item.DuracionMaximaSegundos seg.

                            </td>

                            <td>

                                @item.Orden

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>