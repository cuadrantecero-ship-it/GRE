@model List<GestionRadio.Web.Models.ViewModels.Versiones.VersionesViewModel>

@{
    ViewData["Title"] = "Versiones";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="gr-page-title">
                Versiones
            </h2>

            <small class="text-secondary">
                Administración de versiones asociadas a campañas
            </small>
        </div>

        <div>
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Nueva versión
            </button>

            <button class="btn btn-success ms-2">
                <i class="bi bi-download"></i>
                Importar Dinesat
            </button>
        </div>

    </div>

    <div class="gr-card">

        <table class="table table-hover align-middle">

            <thead>

                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Duración</th>
                    <th>Rotación</th>
                    <th>Preferente</th>
                    <th>Estado</th>
                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="6" class="text-center text-secondary">

                            No existen versiones registradas.

                        </td>

                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.CodigoMaterial</td>

                        <td>@item.TituloMaterial</td>

                        <td>@item.DuracionSegundos s</td>

                        <td>@item.OrdenRotacion</td>

                        <td>

                            @if (item.Preferente)
                            {
                                <span class="badge bg-warning text-dark">
                                    ★ Preferente
                                </span>
                            }

                        </td>

                        <td>

                            @if (item.Activo)
                            {
                                <span class="badge bg-success">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactiva
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>