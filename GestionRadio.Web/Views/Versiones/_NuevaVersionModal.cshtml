@model GestionRadio.Web.Models.ViewModels.Versiones.VersionesViewModel

<div class="modal fade"
     id="modalNuevaVersion"
     tabindex="-1"
     aria-labelledby="modalNuevaVersionLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title" id="modalNuevaVersionLabel">
                    <i class="bi bi-music-note-list"></i>
                    Nueva Versión
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <!-- ========================= -->
                <!-- Campaña -->
                <!-- ========================= -->

                <div class="row">

                    <div class="col-md-12 mb-3">

                        <label asp-for="IdCampania"
                               class="form-label">
                            Campaña
                        </label>

                        <select asp-for="IdCampania"
                                id="IdCampania"
                                class="form-select">

                            <option value="">
                                -- Seleccione una campaña --
                            </option>

                            @foreach (var campania in Model.Campanias)
                            {
                                <option value="@campania.IdCampania">
                                    @campania.Nombre
                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdCampania"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <!-- ========================= -->
                <!-- Material Dinesat -->
                <!-- ========================= -->

                <input asp-for="MaterialIdDinesat"
                       id="MaterialIdDinesat"
                       type="hidden" />

                <div class="row">

                    <div class="col-md-9">

                        <label class="form-label">
                            Material Dinesat
                        </label>

                        <input type="text"
                               id="txtBuscarMaterial"
                               class="form-control"
                               placeholder="Ejemplo: SPO00004" />

                    </div>

                    <div class="col-md-3 d-grid">

                        <label class="form-label">&nbsp;</label>

                        <button type="button"
                                id="btnBuscarMaterial"
                                class="btn btn-outline-primary">

                            <i class="bi bi-search"></i>
                            Buscar

                        </button>

                    </div>

                </div>

                <hr />

                <!-- ========================= -->
                <!-- Información del Material -->
                <!-- ========================= -->

                <div class="row">

                    <div class="col-md-4">

                        <label asp-for="CodigoMaterial"
                               class="form-label">
                        </label>

                        <input asp-for="CodigoMaterial"
                               id="CodigoMaterial"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-8">

                        <label asp-for="TituloMaterial"
                               class="form-label">
                        </label>

                        <input asp-for="TituloMaterial"
                               id="TituloMaterial"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-4">

                        <label asp-for="DuracionSegundos"
                               class="form-label">
                        </label>

                        <input asp-for="DuracionSegundos"
                               id="DuracionSegundos"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-4">

                        <label asp-for="OrdenRotacion"
                               class="form-label">
                        </label>

                        <input asp-for="OrdenRotacion"
                               id="OrdenRotacion"
                               class="form-control"
                               min="1" />

                    </div>

                </div>

                <div class="row mt-4">

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="Preferente"
                                   id="Preferente"
                                   class="form-check-input" />

                            <label asp-for="Preferente"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="Activo"
                                   id="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        id="btnGuardarVersion"
                        class="btn btn-success">

                    <i class="bi bi-check-circle"></i>

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>

<