@model IEnumerable<GestionRadio.Application.DTOs.CampaniaDto>

@{
    ViewData["Title"] = "Campañas";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-0">Campañas</h2>
            <small class="text-muted">
                Administración de campañas comerciales
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Nueva Campaña
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <table class="table table-hover table-bordered align-middle">

        <thead class="table-dark">

            <tr>

                <th>Folio</th>
                <th>Cliente</th>
                <th>Campaña</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th class="text-center">Prioridad</th>
                <th class="text-center">Estado</th>
                <th class="text-center" width="220">
                    Acciones
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {

                <tr>

                    <td>
                        <strong>@item.Folio</strong>
                    </td>

                    <td>
                        @item.Cliente
                    </td>

                    <td>

                        <strong>
                            @item.Nombre
                        </strong>

                        @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                        {
                            <br />
                            <small class="text-muted">
                                @item.Descripcion
                            </small>
                        }

                    </td>

                    <td>
                        @item.FechaInicio.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @item.FechaFin.ToString("dd/MM/yyyy")
                    </td>

                    <td class="text-center">

                        @switch (item.Prioridad)
                        {
                            case 1:
                                <span class="badge bg-danger">Alta</span>
                                break;

                            case 2:
                                <span class="badge bg-warning text-dark">Media</span>
                                break;

                            case 3:
                                <span class="badge bg-primary">Normal</span>
                                break;

                            default:
                                <span class="badge bg-secondary">Baja</span>
                                break;
                        }

                    </td>

                    <td class="text-center">

                        @if (item.Activo)
                        {
                            <span class="badge bg-success">
                                @item.Estado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactiva
                            </span>
                        }

                    </td>

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.IdCampania"
                           class="btn btn-warning btn-sm">

                            Editar

                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.IdCampania"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Desea desactivar esta campaña?')">

                                Desactivar

                            </button>

                        </form>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>