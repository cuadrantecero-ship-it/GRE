@model GestionRadio.Web.Models.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="gr-page-title mb-1">
                Dashboard
            </h2>

            <small class="text-secondary">
                Bienvenido @Model.Usuario · @Model.Emisora
            </small>
        </div>

        <div class="text-end">
            <small class="text-secondary">
                Última sincronización
            </small>
            <br />
            <strong>
                @Model.UltimaSincronizacion.ToString("dd/MM/yyyy HH:mm")
            </strong>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-3">

            <div class="gr-card">

                <h6>Clientes</h6>

                <h2>@Model.TotalClientes</h2>

            </div>

        </div>

        <div class="col-md-3">

            <div class="gr-card">

                <h6>Campañas</h6>

                <h2>@Model.TotalCampanias</h2>

            </div>

        </div>

        <div class="col-md-3">

            <div class="gr-card">

                <h6>Versiones</h6>

                <h2>@Model.TotalVersiones</h2>

            </div>

        </div>

        <div class="col-md-3">

            <div class="gr-card">

                <h6>Materiales Dinesat</h6>

                <h2>@Model.TotalMaterialesDinesat</h2>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-lg-8">

            <div class="gr-card">

                <h5>Actividad reciente</h5>

                <hr />

                <p class="text-secondary">

                    Aquí aparecerán las últimas campañas,
                    versiones y programación.

                </p>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="gr-card">

                <h5>Estado del sistema</h5>

                <hr />

                <p>

                    SQL Server

                    @if (Model.SqlConectado)
                    {
                        <span class="badge bg-success">ONLINE</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">OFFLINE</span>
                    }

                </p>

                <p>

                    Dinesat

                    @if (Model.DinesatConectado)
                    {
                        <span class="badge bg-success">ONLINE</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">OFFLINE</span>
                    }

                </p>

            </div>

        </div>

    </div>

</div>