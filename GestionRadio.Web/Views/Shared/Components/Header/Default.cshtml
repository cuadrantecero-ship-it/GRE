@model GestionRadio.Web.Models.ViewModels.Shared.HeaderViewModel

<header class="gr-header">

    <div class="gr-header-left">

        <div class="gr-logo">

            <i class="bi bi-broadcast-pin"></i>

            <div>

                <div class="gr-system-name">
                    @Model.Sistema
                </div>

                <div class="gr-station">
                    @Model.Emisora
                </div>

            </div>

        </div>

    </div>

    <div class="gr-header-right">

        <div class="gr-status">

            <span class="badge bg-success">
                SQL
            </span>

            <span class="badge bg-success">
                DINESAT
            </span>

        </div>

        <div class="gr-user">

            <i class="bi bi-person-circle"></i>

            @Model.Usuario

        </div>

        <div class="gr-clock">

            <span id="grClock"></span>

        </div>

    </div>

</header>