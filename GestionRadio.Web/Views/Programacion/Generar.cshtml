@{
    ViewData["Title"] = "Generar Programación";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow">

                <div class="card-header bg-warning">

                    <h4 class="mb-0">
                        <i class="bi bi-magic"></i>
                        Generar Programación Automática
                    </h4>

                </div>

                <div class="card-body">

                    <form asp-action="Generar" method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label class="form-label">
                                Fecha
                            </label>

                            <input type="date"
                                   name="fecha"
                                   class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Emisora
                            </label>

                            <select name="emisoraId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione una emisora --
                                </option>

                                @foreach (var item in ViewBag.Emisoras)
                                {
                                    <option value="@item.EmisoraId">
                                        @item.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Parrilla
                            </label>

                            <select name="parrillaId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione una parrilla --
                                </option>

                                @foreach (var item in ViewBag.Parrillas)
                                {
                                    <option value="@item.ParrillaId">
                                        @item.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-magic"></i>
                                Generar Programación

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>