@model GestionRadio.Application.DTOs.Programacion.ProgramacionCreateDto

@{
    ViewData["Title"] = "Nueva Programación";
}

<div class="container-fluid">

    <div class="row">

        <div class="col-lg-8 mx-auto">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">
                        <i class="bi bi-calendar-plus"></i>
                        Nueva Programación
                    </h4>

                </div>


                <div class="card-body">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>



                        <!-- FECHA -->

                        <div class="mb-3">

                            <label asp-for="Fecha"
                                   class="form-label fw-bold">
                                Fecha Programación
                            </label>


                            <input asp-for="Fecha"
                                   class="form-control"
                                   type="date" />


                            <span asp-validation-for="Fecha"
                                  class="text-danger">
                            </span>

                        </div>




                        <!-- EMISORA -->

                        <div class="mb-3">

                            <label asp-for="EmisoraId"
                                   class="form-label fw-bold">
                                Emisora
                            </label>


                            <select asp-for="EmisoraId"
                                    class="form-select">


                                <option value="">
                                    -- Seleccione emisora --
                                </option>


                                @if (ViewBag.Emisoras != null)
                                {
                                    foreach (var emisora in ViewBag.Emisoras)
                                    {
                                        <option value="@emisora.EmisoraId">

                                            @emisora.Nombre (@emisora.Siglas)

                                        </option>
                                    }
                                }


                            </select>


                            <span asp-validation-for="EmisoraId"
                                  class="text-danger">
                            </span>

                        </div>




                        <!-- PARRILLA -->

                        <div class="mb-3">

                            <label asp-for="ParrillaId"
                                   class="form-label fw-bold">
                                Parrilla
                            </label>


                            <select asp-for="ParrillaId"
                                    class="form-select">


                                <option value="">
                                    -- Seleccione parrilla --
                                </option>


                                @if (ViewBag.Parrillas != null)
                                {
                                    foreach (var parrilla in ViewBag.Parrillas)
                                    {
                                        <option value="@parrilla.ParrillaId">

                                            @parrilla.Nombre

                                        </option>
                                    }
                                }


                            </select>


                            <span asp-validation-for="ParrillaId"
                                  class="text-danger">
                            </span>

                        </div>



                        <hr />



                        <div class="d-flex justify-content-end gap-2">


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Regresar

                            </a>



                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-check-circle"></i>

                                Guardar

                            </button>


                        </div>


                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}